# Generate .env.local using: node scripts/init-local.cjs
ENCRYPTION_KEY=
OTP_SECRET=
MONGO_URI=mongodb://localhost:27017/secure_transfer
SMTP_HOST=localhost
SMTP_PORT=1025
APP_URL=http://localhost:3081
PORT=3000
MAX_FILE_SIZE=10485760
MAX_TRANSFERS=4
SCANNER_HOST=localhost
SCANNER_PORT=3310
BILLING_SANDBOX=false
BACKUP_KEY=
STORAGE_DRIVER=filesystem
# For the local private S3 stack, run node scripts/init-s3.cjs.
# S3_ENDPOINT=http://garage:3900
# S3_BUCKET=secure-transfer
# S3_REGION=garage
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=objects/
# Optional JSON object of retained key IDs to hex keys; keep out of Git.
# ENCRYPTION_KEYS={"current":"...64 hex characters..."}
# ENCRYPTION_KEY_ID=current

# Empty by default; comma-separated verified operator emails (maximum 20).
PLATFORM_ADMIN_EMAILS=
# Lossless encrypted upload chunks: 8–16 MiB. Effective file limit also respects scanner capacity.
UPLOAD_CHUNK_SIZE=8388608
SCAN_MAX_FILE_SIZE=26214400
SCANNER_MODE=clamav
SCANNER_IDLE_TIMEOUT_MS=30000
# Required only for an operator-provided full-byte HTTPS inspector; see docs/LARGE_FILES.md.
SCANNER_HTTP_URL=
SCANNER_HTTP_TOKEN=

# No live payments until explicitly configured and accepted with your merchant accounts.
BILLING_MODE=off
BILLING_CATALOG={}
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_PASS_KEY=
# Optional adapter; leave empty until a provider is selected. Supported: bitpay.
CRYPTO_PROVIDER=
BITPAY_POS_TOKEN=
