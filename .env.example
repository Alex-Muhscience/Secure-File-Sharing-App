# Generate .env.local using: node scripts/init-local.cjs
ENCRYPTION_KEY=
OTP_SECRET=
MONGO_URI=mongodb://localhost:27017/secure_transfer
SMTP_HOST=localhost
SMTP_PORT=1025
APP_URL=http://localhost:3081
PORT=3000
MAX_FILE_SIZE=10485760
MAX_TRANSFERS=4
SCANNER_HOST=localhost
SCANNER_PORT=3310
BILLING_SANDBOX=false
BACKUP_KEY=
STORAGE_DRIVER=filesystem
# For the local private S3 stack, run node scripts/init-s3.cjs.
# S3_ENDPOINT=http://garage:3900
# S3_BUCKET=secure-transfer
# S3_REGION=garage
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=objects/
# Optional JSON object of retained key IDs to hex keys; keep out of Git.
# ENCRYPTION_KEYS={"current":"...64 hex characters..."}
# ENCRYPTION_KEY_ID=current
