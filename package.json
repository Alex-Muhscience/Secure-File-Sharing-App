{
  "name": "secure-file-sharing-platform",
  "version": "0.2.0",
  "private": true,
  "description": "Email-verified encrypted file transfers",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration.cjs",
    "check": "node --check app.js && node --check src/app.js && node --check public/script.js"
  },
  "engines": { "node": ">=24" },
  "dependencies": {
    "express": "^5.1.0",
    "mongodb": "^6.20.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.1"
  }
}
